# Django settings module
DJANGO_SETTINGS_MODULE=basil_mail.settings

# Django secret key (generate one: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
DJANGO_SECRET_KEY=change-me

# Comma-separated list of allowed hosts
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Set to True only for development
DJANGO_DEBUG=False

# PostgreSQL connection — either a single DATABASE_URL
DATABASE_URL=postgresql://basil:basil@db:5432/basil_mail
# … or discrete variables (used when DATABASE_URL is not set)
# POSTGRES_DB=basil_mail
# POSTGRES_USER=basil
# POSTGRES_PASSWORD=basil
# POSTGRES_HOST=db
# POSTGRES_PORT=5432

# Optional: local time zone (default UTC)
# DJANGO_TIME_ZONE=Europe/Paris

# Host port for the web service in docker compose (default 8000).
# WEB_PORT=8080 -> http://localhost:8080
# To publish nothing on the host (behind nginx on an internal network),
# leave WEB_PORT unset and apply the docker-compose.no-ports.yml override:
#   docker compose -f docker-compose.yml -f docker-compose.no-ports.yml up -d
# WEB_PORT=8000
